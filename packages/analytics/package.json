{
  "name": "@activescott/analytics",
  "version": "0.3.0",
  "description": "PostHog analytics integration for React Router apps — provider, SPA pageview tracking, user identification, and reverse proxy helper",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proxy": {
      "types": "./dist/proxy.d.ts",
      "import": "./dist/proxy.js"
    },
    "./hosts": {
      "types": "./dist/hosts.d.ts",
      "import": "./dist/hosts.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "posthog",
    "analytics",
    "react-router",
    "spa",
    "pageview",
    "proxy"
  ],
  "author": "Scott Willeke",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/activescott/js-utils.git",
    "directory": "packages/analytics"
  },
  "peerDependencies": {
    "posthog-js": "^1.200.0",
    "react": ">=18",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "jsdom": "^27.4.0",
    "posthog-js": "^1.351.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "^7.10.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  }
}
